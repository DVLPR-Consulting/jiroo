# App DB connection (local Docker by default; Neon pooled in prod)
DATABASE_URL=postgres://jiroo:jiroo@localhost:5433/jiroo
# Direct (non-pooled) endpoint used ONLY for migrations. Same as DATABASE_URL locally.
DIRECT_DATABASE_URL=postgres://jiroo:jiroo@localhost:5433/jiroo

# better-auth
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Seed admin (created by pnpm db:seed)
SEED_ADMIN_EMAIL=admin@cassation.fr
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Administrateur
